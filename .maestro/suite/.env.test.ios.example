# iOS-only overrides (optional).
# Copy to the REPO ROOT as `.env.test.ios`:
#
#   copy .maestro\suite\.env.test.ios.example .env.test.ios
#
# run.ps1 -Platform ios reads .env.test first, then this file.
# A key set here replaces the same key from .env.test.
#
# Main use: a separate test account per platform. Tests empty the account's
# cart and wishlists, so Android and iOS running at the same time on one
# account would break each other.

# TEST_EMAIL=
# TEST_PASSWORD=
