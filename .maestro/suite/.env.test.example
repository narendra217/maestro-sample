# Template for test credentials.
# Copy this file to the REPO ROOT as `.env.test` (same file the old runner reads;
# it is already gitignored) and fill in a real test account:
#
#   copy .maestro\suite\.env.test.example .env.test
#
# run.ps1 passes every KEY=value here to Maestro as --env KEY=value.
# Never put real credentials in YAML files.

TEST_EMAIL=
TEST_PASSWORD=
# Display name shown on the Account screen for this account, e.g. Jane Doe
TEST_NAME=

# Expo Go only (run.ps1 -Launch expo-go, the default). Both optional.
# EXPO_URL      Dev server URL printed by `npx expo start`. When set, the project
#               is opened by deep link, which is more reliable than the list.
# EXPO_PROJECT  Name to tap in Expo Go's project list when EXPO_URL is empty.
#               Default: Mountain Rose
EXPO_URL=
EXPO_PROJECT=
