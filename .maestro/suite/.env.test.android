# Android-only overrides (optional).
# Copy to the REPO ROOT as `.env.test.android`:
#
#   copy .maestro\suite\.env.test.android.example .env.test.android
#
# run.ps1 -Platform android reads .env.test first, then this file.
# A key set here replaces the same key from .env.test.
#
# Main use: a separate test account per platform. Tests empty the account's
# cart and wishlists, so Android and iOS running at the same time on one
# account would break each other.

TEST_EMAIL=mahesh.tel@cennest.com
TEST_PASSWORD=Test@123

TEST_NAME=Mahesh Tel
